# --- required ---
QDRANT_URL=https://your-cluster.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
GEMINI_API_KEY=your-gemini-api-key

# --- embedding provider: local | ollama | gemini (default: local) ---
# RAGPDF_PROVIDER=local
# RAGPDF_LOCAL_MODEL=bge-m3          # bge-m3 | qwen3-0.6b | qwen3-4b | nomic | any HF id
# RAGPDF_OLLAMA_MODEL=bge-m3
# OLLAMA_HOST=http://localhost:11434
# RAGPDF_VLM_MODEL=gemini-flash-latest   # pin for reproducible answers

# --- retrieval knobs ---
# RAGPDF_LIMIT=20        # hybrid candidates
# RAGPDF_VLM_PAGES=4     # top pages sent to the vision model
# RAGPDF_ADJACENT=1      # neighbour pages added around hits
# RAGPDF_MAX_RENDER=8    # hard cap on images per answer

# --- server knobs ---
# PORT=8787
# RAGPDF_RL_MAX=30       # requests per window per IP (classify/ask/upload)
# RAGPDF_RL_WINDOW=60
# RAGPDF_MAX_VLM=3       # simultaneous vision calls
# RAGPDF_DOCS_TTL=60     # /api/docs cache seconds
# QDRANT_PIN_IP=1        # bypass flaky local DNS for *.qdrant.io
